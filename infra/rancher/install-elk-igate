cp -a /var/lib/elasticsearch /data01/elasticsearch
cp -a /data01/elasticsearch /data01/elasticsearch_backup
rm -rf /data01/elasticsearch/*
vi /etc/elasticsearch/elasticsearch.yml
  path.data: /data01/elasticsearch
  cluster.name: igate-elk
  discovery.seed_hosts: ["10.49.201.77:9300"]
chown -R elasticsearch:elasticsearch /data01/elasticsearch
sudo systemctl start elasticsearch

